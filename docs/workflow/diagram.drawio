<mxfile host="app.diagrams.net"><diagram name="HomeStretch workflow"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1675" pageHeight="1111"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_cluster_mcp" value="b&gt;MCP server&lt;/b&gt; (discovered at runtime)&lt;/font" style="rounded=1;dashed=1;fillColor=none;strokeColor=#1B7A80;fontColor=#0F5257;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="1297" y="465" width="285" height="142" as="geometry"/></mxCell><mxCell id="input" value="b&gt;Caregiver input&lt;/b&gt;&lt;br&gt;chat text or label photos&lt;/font" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB8B6;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="116" y="32" width="196" height="58" as="geometry"/></mxCell><mxCell id="route" value="b&gt;route&lt;/b&gt;&lt;br&gt;input type; notes tier-3 words&lt;/font" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB8B6;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="7" y="168" width="415" height="83" as="geometry"/></mxCell><mxCell id="read" value="b&gt;read_photos&lt;/b&gt;&lt;br&gt;Prompt A via OCR&lt;/font" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FCEBD7;strokeColor=#D99A4E;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="19" y="334" width="157" height="58" as="geometry"/></mxCell><mxCell id="names" value="b&gt;check_names&lt;/b&gt;&lt;br&gt;RxNorm per bottle;&lt;br&gt;no match → pharmacist&lt;/font" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FCEBD7;strokeColor=#D99A4E;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="518" width="194" height="67" as="geometry"/></mxCell><mxCell id="mem" value="b&gt;load_memory&lt;/b&gt;&lt;br&gt;session record + last turns&lt;/font" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EDF6F5;strokeColor=#9DB8B6;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="227" y="334" width="214" height="58" as="geometry"/></mxCell><mxCell id="agent" value="b&gt;agent&lt;/b&gt;&lt;br&gt;model picks lookups&lt;br&gt;(tools_v1)&lt;/font" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCEFEC;strokeColor=#1B7A80;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="515" y="494" width="295" height="115" as="geometry"/></mxCell><mxCell id="tools" value="b&gt;tools&lt;/b&gt;&lt;br&gt;orchestrator checks: allowed,&lt;br&gt;valid, no dose search, no repeat&lt;/font" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#DCEFEC;strokeColor=#1B7A80;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="957" y="518" width="251" height="67" as="geometry"/></mxCell><mxCell id="mcp" value="font point-size=&quot;10.5&quot;&gt;check_medicine_name (RxNorm)&lt;br&gt;search_drug_label (FDA labels)&lt;br&gt;get_care_plan · read_label_photo&lt;br&gt;get / update_session_memory&lt;/font" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB8B6;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1309" y="509" width="260" height="86" as="geometry"/></mxCell><mxCell id="answer" value="b&gt;answer&lt;/b&gt;&lt;br&gt;Prompt B v8: reply + triage&lt;br&gt;plan · memory · references&lt;/font" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#0F5257;strokeColor=#0F5257;fontColor=white;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="189" y="673" width="216" height="67" as="geometry"/></mxCell><mxCell id="check" value="b&gt;output_check&lt;/b&gt;&lt;br&gt;ids exist, no diagnosis,&lt;br&gt;no dose advice&lt;/font" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB8B6;fontColor=#1C2B2D;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><