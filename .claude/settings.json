{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m evals.run --model mock *)",
      "Bash(python -m evals.run * --model mock *)",
      "Bash(python -m evals.report *)",
      "Bash(ls *)",
      "Read(./prompts/**)",
      "Read(./evals/**)",
      "Read(./results/**)",
      "Read(./docs/**)",
      "Read(./fixtures/**)"
    ],
    "deny": [
      "Bash(git *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Read(./evals/blind/**)"
    ]
  }
}
